&НаСервере
Процедура УправлениеДоступностьюНастроек()

	// В тестовом режиме настройки неактивны
	Элементы.ГруппаНастройки.Доступность = НЕ ТестовыйРежим;

КонецПроцедуры

&НаСервере
Процедура ТестироватьМеханизмНаСервере()

	ЖурналОтправок.Очистить();

	// Шаг 1: Создать тестовый документ
	Попытка
		ДокОбъект = Документы.ЗаказКлиента.СоздатьДокумент();
		ДокОбъект.Дата = ТекущаяДатаСеанса();
		ДокОбъект.Комментарий = НСтр("ru = '[АРМ ЭДО] Тестовый документ'");
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		ТестовыйДокумент = ДокОбъект.Ссылка;

		ДобавитьСтрокуЖурнала(Строка(ТестовыйДокумент), "", "Создан",
			ТекущаяДатаСеанса(), "", "Документ создан успешно");
	Исключение
		ДобавитьСтрокуЖурнала("<Ошибка>", "", "Ошибка",
			ТекущаяДатаСеанса(), "", "Ошибка создания: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	// Шаг 2: Записать в регистр статус "Ожидает"
	Попытка
		ИдентификаторЗапроса = Строка(Новый УникальныйИдентификатор);

		МенеджерЗаписи = РегистрыСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ЭлектронныйДокумент = ТестовыйДокумент;
		МенеджерЗаписи.ИдентификаторЗапроса = ИдентификаторЗапроса;
		МенеджерЗаписи.Статус = Перечисления.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Ожидает;
		МенеджерЗаписи.ДатаОтправки = ТекущаяДатаСеанса();
		МенеджерЗаписи.Комментарий = "Тестовая запись";
		МенеджерЗаписи.Записать(Истина);

		ДобавитьСтрокуЖурнала(Строка(ТестовыйДокумент), ИдентификаторЗапроса, "Ожидает",
			ТекущаяДатаСеанса(), "", "Статус 'Ожидает' записан");
	Исключение
		ДобавитьСтрокуЖурнала(Строка(ТестовыйДокумент), "", "Ошибка",
			ТекущаяДатаСеанса(), "", "Ошибка записи статуса: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	// Шаг 3: Имитировать ответ — статус "Подтверждено"
	Попытка
		ЭАрМ_ОбработкаПодтвержденийЭДО.ОбработатьОтветПодтверждения(
			ИдентификаторЗапроса, Истина, "Тестовое подтверждение");

		ДобавитьСтрокуЖурнала(Строка(ТестовыйДокумент), ИдентификаторЗапроса, "Подтверждено",
			ТекущаяДатаСеанса(), "Тестовое подтверждение", "Статус 'Подтверждено' записан");
	Исключение
		ДобавитьСтрокуЖурнала(Строка(ТестовыйДокумент), ИдентификаторЗапроса, "Ошибка",
			ТекущаяДатаСеанса(), "", "Ошибка обработки ответа: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	// Шаг 4: Проверить итоговый статус
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Т
		|ГДЕ
		|	Т.ЭлектронныйДокумент = &ЭлектронныйДокумент
		|
		|УПОРЯДОЧИТЬ ПО
		|	Т.ДатаОтправки УБЫВ";
		Запрос.УстановитьПараметр("ЭлектронныйДокумент", ТестовыйДокумент);
		Результат = Запрос.Выполнить();

		Если НЕ Результат.Пустой() Тогда
			Выборка = Результат.Выбрать();
			Выборка.Следующий();
			ТекущийСтатус = Строка(Выборка.Статус);
		Иначе
			ТекущийСтатус = "Не найден";
		КонецЕсли;

		Если ТекущийСтатус = "Подтверждено" Тогда
			Итог = "ТЕСТ ПРОЙДЕН";
		Иначе
			Итог = "ТЕСТ НЕ ПРОЙДЕН: " + ТекущийСтатус;
		КонецЕсли;

		ДобавитьСтрокуЖурнала(Строка(ТестовыйДокумент), ИдентификаторЗапроса, ТекущийСтатус,
			ТекущаяДатаСеанса(), "", Итог);
	Исключение
		ДобавитьСтрокуЖурнала(Строка(ТестовыйДокумент), "", "Ошибка",
			ТекущаяДатаСеанса(), "", "Ошибка проверки: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьЖурналИзРегистра()

	ЖурналОтправок.Очистить();

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.ЭлектронныйДокумент КАК Документ,
		|	Т.ИдентификаторЗапроса КАК ИдентификаторЗапроса,
		|	Т.Статус КАК Статус,
		|	Т.ДатаОтправки КАК ДатаОтправки,
		|	Т.Комментарий КАК Комментарий
		|ИЗ
		|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Т
		|УПОРЯДОЧИТЬ ПО
		|	Т.ДатаОтправки УБЫВ";

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ЖурналОтправок.Добавить();
			НоваяСтрока.Документ = Строка(Выборка.Документ);
			НоваяСтрока.ИдентификаторЗапроса = Выборка.ИдентификаторЗапроса;
			НоваяСтрока.Статус = Строка(Выборка.Статус);
			НоваяСтрока.ДатаОтправки = Выборка.ДатаОтправки;
			НоваяСтрока.Комментарий = Выборка.Комментарий;
		КонецЦикла;
	Исключение
		// Игнорируем ошибку загрузки журнала
	КонецПопытки;

	ПрименитьВизуализациюСтатусов();

КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуЖурнала(Документ, ИдентификаторЗапроса, Статус, Дата, Комментарий, Результат)

	НоваяСтрока = ЖурналОтправок.Добавить();
	НоваяСтрока.Документ = Документ;
	НоваяСтрока.ИдентификаторЗапроса = ИдентификаторЗапроса;
	НоваяСтрока.Статус = Статус;
	НоваяСтрока.ДатаОтправки = Дата;
	НоваяСтрока.Комментарий = Комментарий;
	НоваяСтрока.Результат = Результат;

КонецПроцедуры

&НаСервере
Процедура ПрименитьВизуализациюСтатусов()

	Для Каждого СтрокаЖурнала Из ЖурналОтправок Цикл
		Статус = НРег(СокрЛП(СтрокаЖурнала.Статус));

		// Цвета строк по статусам
		Если Статус = "ожидает" Тогда
			СтрокаЖурнала.Статус = "⏳ Ожидает";
		ИначеЕсли Статус = "подтверждено" Тогда
			СтрокаЖурнала.Статус = "✅ Подтверждено";
		ИначеЕсли Статус = "отклонено" Тогда
			СтрокаЖурнала.Статус = "❌ Отклонено";
		ИначеЕсли Статус = "создан" Тогда
			СтрокаЖурнала.Статус = "🆕 Создан";
		ИначеЕсли Статус = "ошибка" Тогда
			СтрокаЖурнала.Статус = "⚠️ Ошибка";
		ИначеЕсли Статус = "проверен" Тогда
			СтрокаЖурнала.Статус = "🔍 Проверен";
		ИначеЕсли Статус = "отправленвпапку" Тогда
			СтрокаЖурнала.Статус = "📁 Отправлен в папку";
		ИначеЕсли Статус = "регламентновыполнено" Тогда
			СтрокаЖурнала.Статус = "⏰ Регл. задание OK";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

