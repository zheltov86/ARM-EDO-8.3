&НаСервере
Процедура СоздатьТестовыйОтветНаСервере()

	// Находим последний записанный документ в статусе "Ожидает"
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.ИдентификаторЗапроса КАК ИдентификаторЗапроса
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Т
	|ГДЕ
	|	Т.Статус = ЗНАЧЕНИЕ(Перечисление.ЭАрМ_СтатусыОжиданияПодтвержденияЭДО.Ожидает)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.ДатаОтправки УБЫВ";

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ПоказатьПредупреждение(, "Нет документов в статусе 'Ожидает' для создания ответа", 10, "АРМ ЭДО");
		Возврат;
	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();

	РезультатОтвета = ЭАрМ_ПанельУправленияЭДОСервер.СоздатьТестовыйОтвет(
		Выборка.ИдентификаторЗапроса, Истина, "[ТЕСТ] Подтверждение от базы 2");

	ПоказатьПредупреждение(, РезультатОтвета.Результат, 10, "АРМ ЭДО");

КонецПроцедуры

