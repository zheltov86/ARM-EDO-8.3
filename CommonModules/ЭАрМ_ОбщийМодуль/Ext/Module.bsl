// ============================================================================

// Авторизует приложение в СБИС и возвращает sid.
// Логика взята из ПодписаниеЭдо.Авторизоваться().
//
// Возвращаемое значение:
//   Структура - Успех, Ошибка, Сессия
//
Функция Авторизоваться() Экспорт

	Результат = Новый Структура("Успех, Ошибка, Сессия", Истина, "", "");

	ТелоЗапроса = СтрШаблон(
		"{""app_client_id"":""%1"",""app_secret"":""%2"",""secret_key"":""%3""}",
		КлиентIDСБИС(), КлиентСекретСБИС(), СекретныйКлючСБИС());

	АдресРесурса = "/oauth/service/";

	Попытка
		Соединение = СоздатьСоединениеHTTPS(АдресСервераСБИС());

		Запрос = Новый HTTPЗапрос(АдресРесурса);
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8",
			ИспользованиеByteOrderMark.НеИспользовать);

		Ответ = Соединение.ОтправитьДляОбработки(Запрос);

		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
		ДанныеОтвета = ПрочитатьОтветJSON(ТелоОтвета);
		ТекстОшибкиСБИС = ТекстОшибкиОтвета(ДанныеОтвета);

		Если ЗначениеЗаполнено(ТекстОшибкиСБИС) Тогда
			Результат.Успех = Ложь;
			Результат.Ошибка = ТекстОшибкиСБИС;
			Возврат Результат;
		ИначеЕсли Ответ.КодСостояния <> 200 Тогда
			Результат.Успех = Ложь;
			Результат.Ошибка = СтрШаблон("HTTP %1: %2", Ответ.КодСостояния, ТелоОтвета);
			Возврат Результат;
		КонецЕсли;

		// sid может быть в корне или в result
		Сессия = ЗначениеУзла(ДанныеОтвета, "sid");
		Если Не ЗначениеЗаполнено(Сессия) Тогда
			Сессия = ЗначениеУзла(ЗначениеУзла(ДанныеОтвета, "result"), "sid");
		КонецЕсли;

		Если Не ЗначениеЗаполнено(Сессия) Тогда
			Результат.Успех = Ложь;
			Результат.Ошибка = "В ответе нет поля sid";
			Возврат Результат;
		КонецЕсли;

		Результат.Сессия = Сессия;

	Исключение
		Результат.Успех = Ложь;
		Результат.Ошибка = СтрШаблон("Ошибка авторизации: %1",
			ТекстИсключения(ИнформацияОбОшибке()));
		ЗаписатьОшибкуМодуля("Авторизоваться", Результат.Ошибка);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// ============================================================================
// ПОЛУЧЕНИЕ ДОКУМЕНТОВ
// ============================================================================

// Главная точка входа: авторизация + получение + обработка документов из СБИС.
//
Функция ОбработатьДокументыСБИС() Экспорт

	Результат = Новый Структура("Обработано, Ошибки", 0, Новый Массив);

	// Записываем дефолты в регистр, если их там нет
	ЭАрМ_НастройкиСервер.ИнициализироватьНастройкиСБИС();

	// 1. Авторизация
	Авторизация = Авторизоваться();
	Если НЕ Авторизация.Успех Тогда
		Результат.Ошибки.Добавить(Авторизация.Ошибка);
		ЗаписьЖурналаРегистрации("АРМ_ЭДО.СБИС",
			УровеньЖурналаРегистрации.Ошибка, , ,
			Авторизация.Ошибка);
		Возврат Результат;
	КонецЕсли;

	Сессия = Авторизация.Сессия;

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.СБИС",
		УровеньЖурналаРегистрации.Информация, , ,
		"Авторизация успешна, sid получен");

	// 2. Получение списка входящих документов
	СписокДокументов = ПолучитьСписокДокументовСБИС(Сессия);
	Если СписокДокументов = Неопределено Тогда
		Результат.Ошибки.Добавить("Ошибка получения списка документов из СБИС");
		Возврат Результат;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.СБИС",
		УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон("Найдено документов: %1", СписокДокументов.Количество()));

	// 3. Обработка каждого документа
	Для Каждого Элемент Из СписокДокументов Цикл

		ИдентификаторДокумента = "";
		Элемент.Свойство("Идентификатор", ИдентификаторДокумента);

		Попытка
			ДанныеДокумента = ПолучитьДокументСБИС(Сессия, ИдентификаторДокумента);
			Если ДанныеДокумента = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			РезультатОбработки = ЭАрМ_ПриемДокументовДалион.ПринятьДокументЧерезHTTP(ДанныеДокумента);

			СостояниеСБИС = ?(РезультатОбработки.Принято, "Принят", "ОшибкаОбработки");
			ОтправитьРезультатСБИС(Сессия, ИдентификаторДокумента,
				СостояниеСБИС, РезультатОбработки.Комментарий);

			Результат.Обработано = Результат.Обработано + 1;

			ЗаписьЖурналаРегистрации("АРМ_ЭДО.СБИС",
				УровеньЖурналаРегистрации.Информация, , ,
				СтрШаблон("Документ %1 обработан: %2",
					ИдентификаторДокумента, РезультатОбработки.Комментарий));

		Исключение
			ТекстОшибки = СтрШаблон("Ошибка %1: %2",
				ИдентификаторДокумента, ТекстИсключения(ИнформацияОбОшибке()));
			Результат.Ошибки.Добавить(ТекстОшибки);
			ЗаписатьОшибкуМодуля("ОбработатьДокументыСБИС", ТекстОшибки);
		КонецПопытки;

	КонецЦикла;

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.СБИС",
		УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон("Итого: обработано=%1, ошибок=%2",
			Результат.Обработано, Результат.Ошибки.Количество()));

	Возврат Результат;

КонецФункции

// Получение списка входящих документов из СБИС.
// Метод API: СБИС.СписокДокументов (JSON-RPC).
//
Функция ПолучитьСписокДокументовСБИС(Сессия)

	СтруктураФильтра = Новый Структура;
	СтруктураФильтра.Вставить("Тип", "ConsignmentNote");
	СтруктураФильтра.Вставить("Направление", "Входящий");
	СтруктураФильтра.Вставить("ДопПоля", "Стороны,ТекущиеЭтапы");

	Результат = ВыполнитьМетодСБИС("СБИС.СписокДокументов",
		СтруктураФильтра, Сессия);

	Если Результат = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Документы в ответе СБИС лежат в ключах "Реестр" или "Документ"
	СписокДокументов = ЗначениеУзла(Результат, "Реестр");
	Если СписокДокументов = Неопределено Тогда
		СписокДокументов = ЗначениеУзла(Результат, "Документ");
	КонецЕсли;

	Возврат ?(СписокДокументов <> Неопределено, СписокДокументов, Новый Массив);

КонецФункции

// Получение содержимого документа из СБИС.
// Метод API: СБИС.ПрочитатьДокумент (JSON-RPC).
//
Функция ПолучитьДокументСБИС(Сессия, ИдентификаторДокумента)

	СтруктураДокумента = Новый Структура;
	СтруктураДокумента.Вставить("Идентификатор", Строка(ИдентификаторДокумента));
	СтруктураДокумента.Вставить("ДопПоля", "ДопДействия,ТекущиеЭтапы,Подстановки,Стороны");

	Возврат ВыполнитьМетодСБИС("СБИС.ПрочитатьДокумент",
		Новый Структура("Документ", СтруктураДокумента), Сессия);

КонецФункции

// Отправка результата обработки документа обратно в СБИС.
//
Функция ОтправитьРезультатСБИС(Сессия, ИдентификаторДокумента, Состояние, Комментарий = "")

	Параметры = Новый Структура;
	Параметры.Вставить("Идентификатор", ИдентификаторДокумента);
	Параметры.Вставить("Состояние", Состояние);
	Параметры.Вставить("Комментарий", Комментарий);

	Возврат ВыполнитьМетодСБИС("СБИС.УстановитьСостояниеДокумента",
		Параметры, Сессия) <> Неопределено;

КонецФункции

// Универсальный вызов метода СБИС через JSON-RPC.
//
Функция ВыполнитьМетодСБИС(ИмяМетода, СтруктураФильтра, Сессия)

	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("jsonrpc", "2.0");
	СтруктураЗапроса.Вставить("method", ИмяМетода);
	СтруктураЗапроса.Вставить("params", Новый Структура("Фильтр", СтруктураФильтра));
	СтруктураЗапроса.Вставить("id", 1);

	Возврат ВыполнитьЗапросКСБИС(
		СтрШаблон("https://%1/service/?srv=1", АдресСервераСБИС()),
		СтруктураЗапроса, Сессия);

КонецФункции

// ============================================================================
// HTTP-КЛИЕНТ
// ============================================================================

// Выполняет POST-запрос к СБИС с JSON-RPC телом.
//
Функция ВыполнитьЗапросКСБИС(URL, ТелоЗапроса, Сессия = "")

	Попытка
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type", "application/json-rpc;charset=utf-8");
		Если ЗначениеЗаполнено(Сессия) Тогда
			Заголовки.Вставить("X-SBISSessionID", Сессия);
		КонецЕсли;

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, ТелоЗапроса);
		ТелоФайла = ЗаписьJSON.Закрыть();

		СтруктураURL = РазобратьURL(URL);
		Соединение = Новый HTTPСоединение(
			СтруктураURL.Хост, СтруктураURL.Порт, , , , 60,
			Новый ЗащищенноеСоединениеOpenSSL());

		ЗапросHTTP = Новый HTTPЗапрос(СтруктураURL.Путь, Заголовки);
		ЗапросHTTP.УстановитьТелоИзСтроки(ТелоФайла, "UTF-8",
			ИспользованиеByteOrderMark.НеИспользовать);

		ОтветHTTP = Соединение.ОтправитьДляОбработки(ЗапросHTTP);

		ТелоОтвета = ОтветHTTP.ПолучитьТелоКакСтроку();
		ДанныеОтвета = ПрочитатьОтветJSON(ТелоОтвета);

		// Проверяем ошибки бизнес-логики СБИС
		ТекстОшибки = ТекстОшибкиОтвета(ДанныеОтвета);
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			ЗаписатьОшибкуМодуля("ВыполнитьЗапросКСБИС",
				СтрШаблон("Ошибка API: %1 (URL: %2)", ТекстОшибки, URL));
			Возврат Неопределено;
		КонецЕсли;

		Если ОтветHTTP.КодСостояния <> 200 Тогда
			ЗаписатьОшибкуМодуля("ВыполнитьЗапросКСБИС",
				СтрШаблон("HTTP %1: %2", ОтветHTTP.КодСостояния, ТелоОтвета));
			Возврат Неопределено;
		КонецЕсли;

		Возврат ДанныеОтвета;

	Исключение
		ЗаписатьОшибкуМодуля("ВыполнитьЗапросКСБИС",
			СтрШаблон("Ошибка запроса к %1: %2", URL, ТекстИсключения(ИнформацияОбОшибке())));
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область ВспомогательныеФункцииСБИС

// Создает HTTPS-соединение с указанным хостом.
//
Функция СоздатьСоединениеHTTPS(АдресСервера)

	Адрес = СокрЛП(АдресСервера);
	Адрес = СтрЗаменить(Адрес, "https://", "");
	Адрес = СтрЗаменить(Адрес, "http://", "");
	Если Прав(Адрес, 1) = "/" Тогда
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЕсли;

	Попытка
		Возврат Новый HTTPСоединение(Адрес, 443, , , , 60,
			Новый ЗащищенноеСоединениеOpenSSL());
	Исключение
		Возврат Новый HTTPСоединение(Адрес, 443, , , , Истина);
	КонецПопытки;

КонецФункции

// Разбирает JSON-ответ сервера. Возвращает Соответствие (не Структуру).
//
Функция ПрочитатьОтветJSON(ТекстОтвета)

	Если Не ЗначениеЗаполнено(ТекстОтвета) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстОтвета);
		Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	Исключение
		Результат = Неопределено;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Безопасно читает значение из узла JSON (Соответствие или Структура).
//
Функция ЗначениеУзла(Узел, ИмяСвойства, ЗначениеПоУмолчанию = Неопределено)

	Если Узел = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Значение = Неопределено;
	Если ТипЗнч(Узел) = Тип("Соответствие") Тогда
		Значение = Узел.Получить(ИмяСвойства);
	ИначеЕсли ТипЗнч(Узел) = Тип("Структура") Тогда
		Узел.Свойство(ИмяСвойства, Значение);
	КонецЕсли;

	Если Значение = Неопределено Или ТипЗнч(Значение) = Тип("Null") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Собирает текст ошибки из JSON-RPC ответа СБИС.
//
Функция ТекстОшибкиОтвета(ДанныеОтвета, ТекстПоУмолчанию = "")

	Ошибка = ЗначениеУзла(ДанныеОтвета, "error");
	Если Ошибка = Неопределено Тогда
		Возврат ТекстПоУмолчанию;
	КонецЕсли;

	Сообщение = ЗначениеУзла(Ошибка, "message", "");
	Если ТипЗнч(Сообщение) <> Тип("Строка") Тогда
		Сообщение = "";
	КонецЕсли;

	Детали = ЗначениеУзла(Ошибка, "details", "");
	Если ТипЗнч(Детали) <> Тип("Строка") Тогда
		Детали = "";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Сообщение) И Не ЗначениеЗаполнено(Детали) Тогда
		Возврат ТекстПоУмолчанию;
	КонецЕсли;

	Если ЗначениеЗаполнено(Детали) И Детали <> Сообщение Тогда
		Возврат СокрЛП(Сообщение + " - " + Детали);
	КонецЕсли;

	Возврат СокрЛП(Сообщение);

КонецФункции

// Разбирает URL на компоненты.
//
Функция РазобратьURL(URL)

	Результат = Новый Структура("Хост, Порт, Путь, Защищенное", "", 80, "/", Ложь);

	НРегURL = НРег(URL);
	Если СтрНачинаетсяС(НРегURL, "https://") Тогда
		Результат.Защищенное = Истина;
		Результат.Порт = 443;
		ОстатокURL = Сред(URL, 9);
	ИначеЕсли СтрНачинаетсяС(НРегURL, "http://") Тогда
		ОстатокURL = Сред(URL, 8);
	Иначе
		ОстатокURL = URL;
	КонецЕсли;

	Слэш = СтрНайти(ОстатокURL, "/");
	Если Слэш > 0 Тогда
		ХостПорт = Лев(ОстатокURL, Слэш - 1);
		Результат.Путь = Сред(ОстатокURL, Слэш);
	Иначе
		ХостПорт = ОстатокURL;
		Результат.Путь = "/";
	КонецЕсли;

	Двоеточие = СтрНайти(ХостПорт, ":");
	Если Двоеточие > 0 Тогда
		Результат.Хост = Лев(ХостПорт, Двоеточие - 1);
		Результат.Порт = Число(Сред(ХостПорт, Двоеточие + 1));
	Иначе
		Результат.Хост = ХостПорт;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает текст исключения с детализацией.
//
Функция ТекстИсключения(ИнфОбОшибке)

	Попытка
		Возврат ПодробноеПредставлениеОшибки(ИнфОбОшибке);
	Исключение
		Возврат ИнфОбОшибке.Описание;
	КонецПопытки;

КонецФункции

// Записывает ошибку в журнал регистрации.
//
Процедура ЗаписатьОшибкуМодуля(ИмяСобытия, Описание)

	Попытка
		ЗаписьЖурналаРегистрации(
			СтрШаблон("АРМ_ЭДО.%1", ИмяСобытия),
			УровеньЖурналаРегистрации.Ошибка, , ,
			Описание);
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

