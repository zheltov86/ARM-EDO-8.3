
#Область ПрограммныйИнтерфейс

// Обработчик подписки на запись входящего ЭДО.
// Вызывается при записи документа ЭлектронныйДокументВходящийЭДО.
//
Процедура ЭАрМ_ПриЗаписиВходящегоЭДО(Источник, Отказ) Экспорт

	ВидДокумента = Источник.ВидДокумента;
	Если НЕ ЗначениеЗаполнено(ВидДокумента) Тогда
		Возврат;
	КонецЕсли;

	ТипДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидДокумента, "ТипДокумента");

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.ПодпискаВходящий",
		УровеньЖурналаРегистрации.Информация, , Источник.Ссылка,
		СтрШаблон("Тип: %1", ТипДокумента));

	Если ТипДокумента <> Перечисления.ТипыДокументовЭДО.ЭТрН Тогда
		Возврат;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.ПодпискаВходящий",
		УровеньЖурналаРегистрации.Информация, , Источник.Ссылка,
		"ЭТрН обнаружен → обработка");

	ОбработатьВходящийЭТрН(Источник.Ссылка);

КонецПроцедуры

// Обработчик подписки на событие записи состояния ЭДО.
// Вызывается при записи в регистр СостоянияПоОбъектамУчетаЭДО.
//
Процедура ЭАрМ_ПриЗаписиСостоянияПоОбъектамУчетаЭДО(Источник, Отказ, Замещение) Экспорт

	Если Источник.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Запись Из Источник Цикл

		СсылкаНаОбъект = Запись.СсылкаНаОбъект;

		//@skip-check query-in-loop
		ЭлектронныеДокументы = НайтиЭлектронныеДокументыПоОбъектуУчета(СсылкаНаОбъект);

		Для Каждого ЭлектронныйДокумент Из ЭлектронныеДокументы Цикл

			ВидДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				ЭлектронныйДокумент, "ВидДокумента");
			ТипДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				ВидДокумента, "ТипДокумента");

			Если НЕ ЭтоПоддерживаемыйТипДокумента(ТипДокумента) Тогда
				Продолжить;
			КонецЕсли;

			//@skip-check query-in-loop
			Если УжеОтправленНаПодтверждение(ЭлектронныйДокумент) Тогда
				Продолжить;
			КонецЕсли;

			ЭАрМ_ОбработкаПодтвержденийЭДО.ОтправитьНаПодтверждение(ЭлектронныйДокумент);

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обработка входящего ЭТРН.
//
// Параметры:
//   ВходящийЭДО - ДокументСсылка.ЭлектронныйДокументВходящийЭДО - входящий документ
//
Процедура ОбработатьВходящийЭТрН(ВходящийЭДО)

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.ОбработкаЭТрН",
		УровеньЖурналаРегистрации.Информация, , ВходящийЭДО,
		"Начало обработки входящего ЭТрН");

	// >>> Вставить логику обработки <<<

	ЗаписьЖурналаРегистрации("АРМ_ЭДО.ОбработкаЭТрН",
		УровеньЖурналаРегистрации.Информация, , ВходящийЭДО,
		"Обработка завершена");

КонецПроцедуры

// Проверяет, что тип документа поддерживается механизмом ЭДО-обмена.
//
Функция ЭтоПоддерживаемыйТипДокумента(ТипДокумента)

	Возврат ТипДокумента = Перечисления.ТипыДокументовЭДО.УПД
		ИЛИ ТипДокумента = Перечисления.ТипыДокументовЭДО.ЭТрН;

КонецФункции

// Находит электронные документы, связанные с объектом учёта.
//
Функция НайтиЭлектронныеДокументыПоОбъектуУчета(СсылкаНаОбъект)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОбъектыУчетаДокументовЭДО.ЭлектронныйДокумент КАК ЭлектронныйДокумент
	|ИЗ
	|	РегистрСведений.ОбъектыУчетаДокументовЭДО КАК ОбъектыУчетаДокументовЭДО
	|ГДЕ
	|	ОбъектыУчетаДокументовЭДО.ОбъектУчета = &СсылкаНаОбъект
	|	И ОбъектыУчетаДокументовЭДО.ЭлектронныйДокумент ССЫЛКА Документ.ЭлектронныйДокументВходящийЭДО";
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Возврат Результат.Выгрузить().ВыгрузитьКолонку("ЭлектронныйДокумент");

КонецФункции

// Проверяет, что документ уже отправлен на подтверждение.
//
Функция УжеОтправленНаПодтверждение(ЭлектронныйДокумент)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК Поле1
	|ИЗ
	|	РегистрСведений.ЭАрМ_ОжидаемыеПодтвержденияЭДО КАК Т
	|ГДЕ
	|	Т.ЭлектронныйДокумент = &ЭлектронныйДокумент";
	Запрос.УстановитьПараметр("ЭлектронныйДокумент", ЭлектронныйДокумент);

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

#КонецОбласти
